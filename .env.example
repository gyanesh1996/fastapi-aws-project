# Copy to .env and fill in. NEVER commit the real .env.

# Phase 1 — Claude API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Phase 2 — your channel name, shown at the top of posters (leave empty for none)
BRAND_NAME=

# Phase 3 — free AI voice (hi-IN-SwaraNeural = female, hi-IN-MadhurNeural = male)
TTS_VOICE=hi-IN-SwaraNeural

# Phase 4 — Telegram bot token from @BotFather. TELEGRAM_CHAT_ID is added
# automatically when you connect your phone with /start <code>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Later phases will add:
#   Phase 5 — YouTube OAuth client (client_secret.json, git-ignored)
