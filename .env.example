# Copy to .env and fill in. NEVER commit the real .env.

# ScraperAPI key — enables real residential/geo egress (get it from
# https://dashboard.scraperapi.com). Without this the tracer runs in "direct"
# mode and ad networks will return 403.
SCRAPERAPI_KEY=

# Proxy tier strategy per hop:
#   auto    -> datacenter first, auto-escalate to residential/ultra on block (recommended)
#   basic   -> datacenter only (cheapest, usually blocked by ad networks)
#   premium -> residential IPs (10 credits/hop)
#   ultra   -> ultra_premium anti-bot bypass (30 credits/hop)
PROXY_TIER=auto

# Follow JavaScript/SDK redirects via a headless-render pass when a hop stalls.
ENABLE_RENDER_ESCALATION=true

# Limits
MAX_HOPS=25
REQUEST_TIMEOUT=40
RENDER_TIMEOUT=80
